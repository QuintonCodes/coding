@model List<Employee>
@{
    ViewData["Title"] = "Employee List";
}

<h2>Employee List</h2>

<p>
    <a asp-controller="Employee" asp-action="Create" class="btn btn-primary">Add New Employee</a>
    <a asp-controller="Auth" asp-action="Logout" class="btn btn-secondary float-end">Logout</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Full Name</th>
            <th>Email Address</th>
            <th>Job Title</th>
            <th>Department</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.EmployeeId</td>
                <td>@employee.FullName</td>
                <td>@employee.EmailAddress</td>
                <td>@employee.JobTitle</td>
                <td>@employee.Department</td>
                <td>
                    <a asp-controller="Employee" asp-action="Edit" asp-route-id="@employee.EmployeeId" class="btn btn-warning">Edit</a>
                    <a asp-controller="Employee" asp-action="Details" asp-route-id="@employee.EmployeeId" class="btn btn-info">View</a>
                    <a asp-controller="Employee" asp-action="Delete" asp-route-id="@employee.EmployeeId" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>